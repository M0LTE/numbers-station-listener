# /etc/nsl/nsl.env - see docs/deploy.md for every variable.
NSL_LISTEN=:8080
NSL_DATA_DIR=/var/lib/nsl
NSL_CONTACT=M0LTE
# NSL_PUBLIC_URL=https://numbers.example.org
# Development: only ever connect to or probe M0LTE's own receiver.
# Remove this line at go-live to use every public UberSDR.
NSL_RECEIVER_ALLOW=M0LTE
